# Production Environment Configuration
# Copy this file to .env and update with real values

ENVIRONMENT=prod
COMPOSE_PROJECT_NAME=hrms-prod

# Domain — update with your actual domain
TRAEFIK_DOMAIN=hrms.yourdomain.com

# Site
SITE_NAME=hrms.yourdomain.com

# Database
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Docker image (built by CI/CD)
FRAPPE_IMAGE=ghcr.io/gat-so/hrms
FRAPPE_IMAGE_TAG=prod

# Frappe
FRAPPE_BRANCH=develop
