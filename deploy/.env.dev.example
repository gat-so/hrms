# Development Environment Configuration
# Copy this file to .env and update with real values

ENVIRONMENT=dev
COMPOSE_PROJECT_NAME=hrms-dev

# Domain — update with your actual domain
TRAEFIK_DOMAIN=dev.hrms.yourdomain.com

# Site
SITE_NAME=dev.hrms.yourdomain.com

# Database
DB_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Admin
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Docker image (built by CI/CD)
FRAPPE_IMAGE=ghcr.io/gat-so/hrms
FRAPPE_IMAGE_TAG=dev

# Frappe
FRAPPE_BRANCH=develop

# Shared infrastructure network (must match deploy-infra.sh output)
INFRA_NETWORK=hrms-dev-infra
